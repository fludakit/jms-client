<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fludakit</groupId>
        <artifactId>fludakit-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

        <artifactId>fluda-jms-client-parent</artifactId>
    <packaging>pom</packaging>

    <!-- TODO: Update name, description, and URL -->
    <name>FluDa :: Jms Client</name>
    <description>A fluent JMS client for Jakarta Messaging - send/receive with a MessageConverter SPI, in Java SE, CDI, and Jakarta EE.</description>
    <url>https://github.com/fludakit/jms-client</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Hantsy Bai</name>
            <email>hantsy@gmail.com</email>
        </developer>
    </developers>

    <!-- TODO: Update SCM URLs to your repository -->
    <scm>
        <connection>scm:git:git://github.com/fludakit/jms-client.git</connection>
        <developerConnection>scm:git:ssh://github.com/fludakit/jms-client.git</developerConnection>
        <url>https://github.com/fludakit/jms-client</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>core</module>
        <module>cdi</module>
    </modules>

    <properties>
        <!-- Module-specific properties can be added here -->
        <artemis.version>2.40.0</artemis.version>
        <qpid-jms.version>2.7.0</qpid-jms.version>
        <yasson.version>3.0.5</yasson.version>
        <fluda-jms-client.version>1.0.0-SNAPSHOT</fluda-jms-client.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- jakarta.jms-api is version-managed by the parent's jakarta.jms-api.version BOM;
                 a version-less override here shadows that import and breaks Maven 3 -->
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-jms-client-core</artifactId>
                <version>${fluda-jms-client.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-jms-client-cdi</artifactId>
                <version>${fluda-jms-client.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.activemq</groupId>
                <artifactId>artemis-jakarta-client</artifactId>
                <version>${artemis.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.qpid</groupId>
                <artifactId>qpid-jms-client</artifactId>
                <version>${qpid-jms.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse</groupId>
                <artifactId>yasson</artifactId>
                <version>${yasson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Module-specific plugin configurations can be added here -->
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Module-specific profiles can be added here -->
    </profiles>

    <!-- TODO: Update distributionManagement URL to your repository -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/fludakit/jms-client</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <name>GitHub Packages - Fludakit Org</name>
            <id>github-fludakit</id>
            <url>https://maven.pkg.github.com/fludakit/*</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
